# Long-lived Max-subscription OAuth token. Generate ONCE on the host:
#
#   claude setup-token
#
# Copy the printed token (starts with ``sk-ant-oat01-...``) into the line
# below, save as ``.env`` (no ``.example`` suffix), then:
#
#   docker compose up -d --build
#
# The token doesn't expire -- no refresh, no terminal stuff after this
# one-time setup. Same auth path Strategy Miner uses.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-PASTE-YOUR-TOKEN-HERE
