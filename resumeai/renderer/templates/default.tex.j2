%%% resumeai default LaTeX template
%%% Adapted from Jake Gutierrez's resume template (MIT) -- github.com/jakegut/resume
%%% Driven by Jinja2 with custom delimiters (see latex_renderer.py).
%%% Tectonic / XeTeX compatible (no pdfTeX-only primitives).

\documentclass[letterpaper,11pt]{article}

\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}
\usepackage{needspace} % \needspace forces a break when N lines below this point won't fit

\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\addtolength{\oddsidemargin}{-0.5in}
\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1in}
\addtolength{\topmargin}{-.5in}
\addtolength{\textheight}{1.0in}

\urlstyle{same}
\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Refuse to break a paragraph across pages with a single dangling line.
% Default ``\widowpenalty=150`` lets LaTeX strand the last line of a
% bullet at the top of the next page (e.g. "references into Sanity."
% alone on page 3 after the rest of the bullet ended page 2). Cranking
% to 10000 forces LaTeX to choose a different break point or pull the
% whole paragraph forward / back together.
\widowpenalty=10000
\clubpenalty=10000

% Section headings need to read as TITLES, not as label text -- previous
% ``\scshape\large`` was the same visual weight as ``\textbf{employer}``
% inside entries, so PROFILE and ``Swinburne University`` looked equivalent.
% Bold + small caps + Large gives a clear hierarchy: section > entry-name.
\titleformat{\section}{
  \vspace{4pt}\bfseries\scshape\raggedright\Large
}{}{0em}{}[\color{black}\titlerule \vspace{3pt}]
\linespread{1.08}

% ---- helper commands (resume-specific layout) -------------------------------
\newcommand{\resumeItem}[1]{
  \item\small{ {#1} }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-2pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & #2 \\
    \end{tabular*}\vspace{-2pt}
}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

% ``itemsep=2pt topsep=2pt parsep=0pt partopsep=0pt`` -- enumitem's
% defaults add roughly half a baseline of glue between items, which made
% the gaps between Education entries and between Key Achievements bullets
% look uneven (and let the page-bottom stretch grow whichever bullet
% happened to be near a break). Pinning all four spacing knobs keeps the
% vertical rhythm uniform across all list-based sections.
\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}, itemsep=2pt, topsep=2pt, parsep=0pt, partopsep=0pt]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[itemsep=2pt, topsep=2pt, parsep=0pt, partopsep=0pt]}
\newcommand{\resumeItemListEnd}{\end{itemize}}

%%%===========================================================================
\begin{document}

%----------HEADING----------
\begin{center}
    \textbf{\Huge \scshape \VAR{resume.name}} \\ \vspace{1pt}
    \BLOCK{if resume.headline}\small \textit{\VAR{resume.headline}} \\ \vspace{2pt}\BLOCK{endif}
    \small
    \BLOCK{set parts = [] }\#{}
    \BLOCK{if resume.contact.location}\BLOCK{set _ = parts.append(resume.contact.location) }\BLOCK{endif}
    \BLOCK{if resume.contact.email}\BLOCK{set _ = parts.append('\\href{mailto:' ~ resume.contact.email ~ '}{' ~ resume.contact.email ~ '}') }\BLOCK{endif}
    \BLOCK{if resume.contact.phone}\BLOCK{set _ = parts.append(resume.contact.phone) }\BLOCK{endif}
    \BLOCK{if resume.contact.github}\BLOCK{set _ = parts.append('\\href{https://' ~ resume.contact.github ~ '}{' ~ resume.contact.github ~ '}') }\BLOCK{endif}
    \BLOCK{if resume.contact.linkedin}\BLOCK{set _ = parts.append('\\href{https://' ~ resume.contact.linkedin ~ '}{' ~ resume.contact.linkedin ~ '}') }\BLOCK{endif}
    \BLOCK{if resume.contact.website}\BLOCK{set _ = parts.append('\\href{https://' ~ resume.contact.website ~ '}{' ~ resume.contact.website ~ '}') }\BLOCK{endif}
    \VAR{ parts | join(' $|$ ') }
\end{center}

%----------PROFILE----------
\BLOCK{if resume.summary}
\section{Profile}
\begin{itemize}[leftmargin=0.15in, label={}, topsep=2pt, partopsep=0pt]
  \small\item \VAR{resume.summary}
\end{itemize}
\BLOCK{endif}

%----------SKILLS----------
\BLOCK{if resume.skills}
\section{Technical Skills}
\begin{itemize}[leftmargin=0.15in, label={}, topsep=2pt, partopsep=0pt]
  \small\item{ \VAR{resume.skills | join(', ')} }
\end{itemize}
\BLOCK{endif}

%----------EDUCATION----------
\BLOCK{if resume.education or resume.certifications}
\section{Education}
\resumeSubHeadingListStart
\BLOCK{for edu in resume.education}
  \resumeSubheading
    {\VAR{edu.institution}}{\VAR{edu | format_period}}
    {\VAR{edu.degree}\BLOCK{if edu.field} --- \VAR{edu.field}\BLOCK{endif}}{}
\BLOCK{endfor}
\BLOCK{for cert in resume.certifications}
  \resumeSubheading
    {\VAR{cert}}{}{}{}
\BLOCK{endfor}
\resumeSubHeadingListEnd
\BLOCK{endif}

%----------KEY ACHIEVEMENTS----------
\BLOCK{if resume.key_achievements}
\section{Key Achievements}
\resumeSubHeadingListStart
\BLOCK{for achievement in resume.key_achievements}
  \resumeItem{\VAR{achievement}}
\BLOCK{endfor}
\resumeSubHeadingListEnd
\BLOCK{endif}

%----------EXPERIENCE----------
\BLOCK{if resume.work_history}
% ``\needspace`` forces a page break NOW if 8 baselines won't fit
% below this point -- protects the section header + first entry from
% getting orphaned at the bottom of a page with the rest of the
% section on the next. ``\nopagebreak`` alone is a soft hint LaTeX
% will override; ``needspace`` is a hard guarantee.
\needspace{8\baselineskip}
\section{Professional Experience}
\nopagebreak[4]
\resumeSubHeadingListStart
\BLOCK{for job in resume.work_history}
  \resumeSubheading
    {\VAR{job.company}}{\VAR{job.period or ''}}
    {\VAR{job.title}}{\VAR{job.location or ''}}
  \BLOCK{if job.bullets}
  \resumeItemListStart
  \BLOCK{for bullet in job.bullets}
    \resumeItem{\VAR{bullet.text}}
  \BLOCK{endfor}
  \resumeItemListEnd
  \BLOCK{endif}
\BLOCK{endfor}
\resumeSubHeadingListEnd
\BLOCK{endif}

%----------PERSONAL PROJECTS----------
%
% Title row uses ``\hfill`` instead of a ``tabular*`` so the right column
% (link or "Private project" label) NEVER overflows the page width --
% the previous ``tabular*{0.97\textwidth}`` clipped "Private project"
% to "Privat" because the 0.15in list-margin + tabular's right edge
% pushed past the page boundary. ``\hfill`` between the title and the
% right-column lets LaTeX size both naturally to the available width.
% Subtitle (description + stack) is a normal paragraph below so a long
% stack wraps cleanly.
\BLOCK{if resume.personal_projects}
\section{Personal Projects}
\resumeSubHeadingListStart
\BLOCK{for project in resume.personal_projects}
  \BLOCK{set right_col = '' }\#{}
  \BLOCK{if project.link}\BLOCK{set right_col = '{\\small \\href{' ~ project.link ~ '}{' ~ (project.link_label or project.link) ~ '}}' }\BLOCK{elif project.link_label}\BLOCK{set right_col = '{\\small ' ~ project.link_label ~ '}' }\BLOCK{endif}
  \BLOCK{set subtitle_parts = [] }\#{}
  \BLOCK{if project.description}\BLOCK{set _ = subtitle_parts.append(project.description) }\BLOCK{endif}
  \BLOCK{if project.stack}\BLOCK{set _ = subtitle_parts.append('\\emph{' ~ project.stack ~ '}') }\BLOCK{endif}
  \vspace{2pt}\item
  \textbf{\VAR{project.name}}\hfill\VAR{right_col}
  \BLOCK{if subtitle_parts}\\\textit{\small \VAR{subtitle_parts | join(' $|$ ')}}\BLOCK{endif}
  \BLOCK{if project.bullets}
  \resumeItemListStart
  \BLOCK{for bullet in project.bullets}
    \resumeItem{\VAR{bullet.text}}
  \BLOCK{endfor}
  \resumeItemListEnd
  \BLOCK{endif}
\BLOCK{endfor}
\resumeSubHeadingListEnd
\BLOCK{endif}

\end{document}
